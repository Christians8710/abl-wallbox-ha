[Unit]
Description=ABL durable network diagnostics
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/abl-network-diagnostics
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/abl-bridge

[Install]
WantedBy=multi-user.target
